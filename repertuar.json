from pathlib import Path
import re, json

src = Path("/mnt/data/Repertuar.txt")
text = src.read_text(encoding="utf-8-sig")

artists = [
"ATHENA","AYNA","BARIŞ AKARSU","BARIŞ MANÇO","DUMAN","HALUK LEVENT","KARGO","KOLPA","KURBAN",
"KURTALAN EKSPRES","MOR VE ÖTESİ","MOĞOLLAR","MURAT KEKİLLİ","OGÜN SANLISOY","PENTAGRAM","SIFIR KM",
"YAVUZ ÇETİN","YÜKSEK SADAKAT","ŞEBNEM FERAH","AC/DC","BLACK SABBATH","BON JOVI","DEF LEPPARD","DIO",
"EUROPE","GUNS N' ROSES","IRON MAIDEN","JUDAS PRIEST","MANOWAR","MEGADETH","METALLICA","NIRVANA",
"PANTERA","SCORPIONS","SLAYER","SEPULTURA"
]

songs=[]
for line in text.splitlines():
    s=line.strip()
    m=re.match(r"^(\d+)\s+(.+)$", s)
    if not m:
        continue
    num=int(m.group(1)); rest=m.group(2)
    for a in sorted(artists, key=len, reverse=True):
        if rest.startswith(a+" "):
            title=rest[len(a):].strip()
            songs.append({"id":num,"artist":a,"title":title})
            break

out = Path("/mnt/data/repertuar.json")
out.write_text(json.dumps(songs, ensure_ascii=False, indent=2), encoding="utf-8")
print(f"{len(songs)} şarkılık repertuar.json hazırlandı: {out}")
